enum InvoiceStatus {
  ISSUED
  DRAFTED
}

enum InvoicePaymentStatus {
  PAID
  DUE
  OVERDUE
}

enum InvoicePurpose {
  BILLING
  ORDER
}

model Invoice {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  storeId         String               @db.Uuid
  customerId      String?              @db.Uuid
  purpose         InvoicePurpose       @default(BILLING)
  invoiceNumber   String
  issueDate       DateTime             @default(now())
  subTotal        Float
  total           Float
  discountAmount  Float                @default(0)
  discountPercent Float                @default(0)
  dueAmount       Float                @default(0)
  paidAmount      Float                @default(0)
  taxAmount       Float                @default(0)
  taxRate         Float                @default(0)
  totalProfit     Float                @default(0)
  roundupTotal    Boolean              @default(false)
  note            String?
  status          InvoiceStatus        @default(DRAFTED)
  paymentStatus   InvoicePaymentStatus @default(PAID)
  extraData       Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  user      User          @relation(fields: [userId], references: [id])
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer?     @relation(fields: [customerId], references: [id])
  billItems InvoiceItem[]
  orders    Order[]

  @@index([storeId])
  @@index([invoiceNumber])
  @@index([storeId, status])
  @@index([storeId, paymentStatus])
  @@index([storeId, customerId])
  @@index([storeId, purpose])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  sortOrder   Int     @default(1)
  productId   String? @db.Uuid
  productName String  @default("")
  pricePerQty Json?
  netQuantity Float
  totalPrice  Float
  stockUnit   String
  totalProfit Float   @default(0)

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model InvoiceSummary {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @unique @db.Uuid

  // Invoice aggregates (lifetime)
  totalRevenue Float @default(0)
  totalPaid    Float @default(0)
  totalDue     Float @default(0)
  totalProfit  Float @default(0)
  invoiceCount Int   @default(0)

  // Product aggregates (lifetime)
  totalProductsSold Float @default(0)

  // Customer counts
  totalCustomers Int @default(0)

  // Billing status snapshot
  paidInvoices    Int @default(0)
  partialInvoices Int @default(0)
  unpaidInvoices  Int @default(0)

  updatedAt DateTime @updatedAt

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("invoice_summaries")
}
