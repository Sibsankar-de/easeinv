<mjml>
  <mj-head>
    <mj-title>{{#if hasOutOfStock}}🚨 Out of Stock Alert: {{ totalAffectedCount }} {{ itemLabel }} in {{ storeName }}{{else}}⚠️ Low Stock Alert: {{ totalAffectedCount }} {{ itemLabel }} in {{ storeName }}{{/if}}</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.05),
          0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }
      .batch-table {
        width: 100%;
        border-collapse: collapse;
      }
      .link-text {
        color: #4f39f6;
        text-decoration: none;
        word-break: break-all;
      }
      .restock-link {
        display: inline-block;
        color: #4f39f6;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        white-space: nowrap;
      }
      .restock-link:hover {
        text-decoration: underline;
      }
      .footer-link {
        color: #9ca3af;
        text-decoration: none;
        font-weight: 500;
      }
      .footer-link:hover {
        color: #4f39f6;
        text-decoration: underline;
      }
      .alert-badge {
        display: inline-block;
        background-color: #fee2e2;
        color: #dc2626;
        padding: 3px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 12px;
        white-space: nowrap;
      }
      .warning-badge {
        display: inline-block;
        background-color: #fef3c7;
        color: #d97706;
        padding: 3px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 12px;
        white-space: nowrap;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <!-- LOGO HEADER -->
    <mj-section padding="32px 24px 24px">
      <mj-column>
        <mj-image
          src="https://easeinv.app/easeinv-logo-full.png"
          alt="EaseInv Logo"
          width="120px"
          align="center"
        />
      </mj-column>
    </mj-section>

    <!-- MAIN CARD -->
    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <!-- Header -->
        <mj-text
          font-size="20px"
          font-weight="700"
          color="{{#if hasOutOfStock}}#dc2626{{else}}#d97706{{/if}}"
          padding-bottom="16px"
        >
          {{#if hasOutOfStock}}🚨 Stock Alert: Items Require Immediate Restocking{{else}}⚠️ Low Stock Alert: Items Below Threshold{{/if}}
        </mj-text>

        <mj-text padding-bottom="12px">
          Hi <strong>{{ recipientName }}</strong>,
        </mj-text>

        <mj-text padding-bottom="24px">
          This is an automated notification to let you know that the stock level for <strong>{{ totalAffectedCount }}</strong> {{ itemLabel }} in your store <strong>{{ storeName }}</strong> reached or dropped below the stock alert threshold:
        </mj-text>

        <!-- Products Table -->
        <mj-table css-class="batch-table" padding="0" line-height="1.5">
          <thead>
            <tr style="border-bottom: 2px solid #e5e7eb; text-align: left;">
              <th style="padding: 10px 8px 10px 0; font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Product</th>
              <th style="padding: 10px 8px; font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; text-align: center;">Stock</th>
              <th style="padding: 10px 8px; font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; text-align: center;">Alert At</th>
              <th style="padding: 10px 8px; font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; text-align: center;">Status</th>
              <th style="padding: 10px 0 10px 8px; font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
            <tr style="border-bottom: 1px solid #f3f4f6;">
              <td style="padding: 12px 8px 12px 0; vertical-align: middle;">
                <div style="font-size: 14px; font-weight: 600; color: #111827;">{{ this.productName }}</div>
                <div style="font-size: 12px; font-family: monospace; color: #6b7280; margin-top: 2px;">SKU: {{ this.productSku }}</div>
              </td>
              <td style="padding: 12px 8px; text-align: center; vertical-align: middle;">
                <span class="{{ this.badgeClass }}">{{ this.currentStock }} {{ this.stockUnit }}</span>
              </td>
              <td style="padding: 12px 8px; text-align: center; font-size: 13px; color: #4b5563; vertical-align: middle;">
                {{ this.threshold }} {{ this.stockUnit }}
              </td>
              <td style="padding: 12px 8px; text-align: center; vertical-align: middle;">
                <span class="{{ this.badgeClass }}">{{ this.statusText }}</span>
              </td>
              <td style="padding: 12px 0 12px 8px; text-align: right; vertical-align: middle;">
                <a href="{{ this.inventoryLink }}" class="restock-link">Restock &rarr;</a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </mj-table>

        <mj-spacer height="28px" />

        <!-- CTA Button -->
        <mj-button
          background-color="#dc2626"
          color="#ffffff"
          href="{{ inventoryDashboardLink }}"
          font-size="15px"
          font-weight="600"
          border-radius="8px"
          padding="0"
          inner-padding="14px 28px"
          align="center"
        >
          Manage Inventory
        </mj-button>

        <mj-spacer height="28px" />

        <mj-divider
          border-color="#F3F4F6"
          border-width="1px"
          padding="0 0 20px"
        />

        <mj-text font-size="13px" color="#9CA3AF">
          Please make sure to replenish stock to prevent sales loss or delays.
          If you've already restocked these items, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text
          align="center"
          font-size="12px"
          color="#9CA3AF"
          padding-bottom="12px"
        >
          <a href="https://easeinv.app/about" class="footer-link">About</a>
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/contact" class="footer-link"
            >Contact Support</a
          >
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/privacy-policy" class="footer-link"
            >Privacy Policy</a
          >
        </mj-text>
        <mj-text align="center" font-size="11px" color="#BDBDBD">
          © {{ currentYear }} EaseInv. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
