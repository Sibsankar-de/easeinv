<mjml>
  <mj-head>
    <mj-title>Order Completed & Invoice Issued: {{ orderNumber }}</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.05),
          0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }
      .details-table {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
      }
      .completed-badge {
        display: inline-block;
        background-color: #dcfce7;
        color: #15803d;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 13px;
      }
      .footer-link {
        color: #9ca3af;
        text-decoration: none;
        font-weight: 500;
      }
      .footer-link:hover {
        color: #4f39f6;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <!-- LOGO HEADER -->
    <mj-section padding="32px 24px 24px">
      <mj-column>
        <mj-image
          src="https://easeinv.app/easeinv-logo-full.png"
          alt="EaseInv Logo"
          width="120px"
          align="center"
        />
      </mj-column>
    </mj-section>

    <!-- MAIN CARD -->
    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="700"
          color="#15803d"
          padding-bottom="16px"
        >
          ✅ Order Delivered & Completed
        </mj-text>

        <mj-text padding-bottom="12px">
          Hi <strong>{{ customerName }}</strong>,
        </mj-text>

        <mj-text padding-bottom="20px">
          Thank you for your business! Your order <strong>#{{ orderNumber }}</strong> from
          <strong>{{ storeName }}</strong> is now complete, and your invoice <strong>#{{ invoiceNumber }}</strong> has been officially issued.
        </mj-text>

        <!-- Summary Box -->
        <mj-table
          css-class="details-table"
          padding="16px 20px"
          line-height="1.5"
        >
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b; width: 40%">
              Order Number
            </td>
            <td style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a">
              {{ orderNumber }}
            </td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">
              Invoice Number
            </td>
            <td style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a">
              {{ invoiceNumber }}
            </td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">
              Status
            </td>
            <td style="padding: 6px 0; font-size: 14px">
              <span class="completed-badge">COMPLETED</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">
              Subtotal
            </td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">
              {{ currencyCode }} {{ subtotal }}
            </td>
          </tr>
          {{#if discountAmount}}
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">
              Discount
            </td>
            <td style="padding: 6px 0; font-size: 14px; color: #16a34a">
              - {{ currencyCode }} {{ discountAmount }}
            </td>
          </tr>
          {{/if}}
          {{#if shippingAmount}}
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">
              Shipping
            </td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">
              {{ currencyCode }} {{ shippingAmount }}
            </td>
          </tr>
          {{/if}}
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">
              Total Amount
            </td>
            <td style="padding: 6px 0; font-size: 15px; font-weight: 700; color: #0f172a">
              {{ currencyCode }} {{ totalAmount }}
            </td>
          </tr>
        </mj-table>

        <mj-spacer height="20px" />

        <mj-divider
          border-color="#F3F4F6"
          border-width="1px"
          padding="12px 0 20px"
        />

        <mj-text font-size="13px" color="#94a3b8">
          Thank you for choosing <strong>{{ storeName }}</strong>. For any support or inquiries, please contact us{{#if storeContact}} at {{ storeContact }}{{/if}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text
          align="center"
          font-size="12px"
          color="#9CA3AF"
          padding-bottom="12px"
        >
          <a href="https://easeinv.app/about" class="footer-link">About</a>
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/contact" class="footer-link"
            >Contact Support</a
          >
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/privacy-policy" class="footer-link"
            >Privacy Policy</a
          >
        </mj-text>
        <mj-text align="center" font-size="11px" color="#BDBDBD">
          © {{ currentYear }} EaseInv. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
