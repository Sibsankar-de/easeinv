<mjml>
  <mj-head>
    <mj-title>New Customer Inquiry</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.05),
          0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }
      .field-label {
        font-weight: 600;
        color: #4b5563;
      }
      .field-value {
        color: #111827;
      }
      .footer-link {
        color: #9ca3af;
        text-decoration: none;
        font-weight: 500;
      }
      .footer-link:hover {
        color: #4f39f6;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <!-- LOGO HEADER -->
    <mj-section padding="32px 24px 24px">
      <mj-column>
        <mj-image
          src="https://easeinv.app/easeinv-logo-full.png"
          alt="EaseInv Logo"
          width="120px"
          align="center"
        />
      </mj-column>
    </mj-section>

    <!-- MAIN CARD -->
    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <mj-text
          font-size="22px"
          font-weight="700"
          color="#111827"
          padding-bottom="16px"
        >
          New Customer Inquiry 📩
        </mj-text>

        <mj-text padding-bottom="16px">
          You have received a new support inquiry from the contact form:
        </mj-text>

        <mj-text padding-bottom="8px">
          <span class="field-label">Name:</span>
          <span class="field-value">{{senderName}}</span>
        </mj-text>

        <mj-text padding-bottom="8px">
          <span class="field-label">Email:</span>
          <span class="field-value">{{senderEmail}}</span>
        </mj-text>

        <mj-text padding-bottom="20px">
          <span class="field-label">Submitted At:</span>
          <span class="field-value">{{submittedAt}}</span>
        </mj-text>

        <mj-text font-weight="600" color="#111827" padding-bottom="8px">
          Message:
        </mj-text>

        <mj-text
          background-color="#F9FAFB"
          padding="16px"
          border-radius="8px"
          border="1px solid #E5E7EB"
        >
          {{senderMessage}}
        </mj-text>

        <mj-spacer height="28px" />

        <mj-divider
          border-color="#F3F4F6"
          border-width="1px"
          padding="0 0 20px"
        />

        <mj-text font-size="13px" color="#9CA3AF">
          This message was routed automatically from the EaseInv Customer Support portal.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text
          align="center"
          font-size="12px"
          color="#9CA3AF"
          padding-bottom="12px"
        >
          <a href="https://easeinv.app/about" class="footer-link">About</a>
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/contact" class="footer-link"
            >Contact Support</a
          >
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/privacy-policy" class="footer-link"
            >Privacy Policy</a
          >
        </mj-text>
        <mj-text align="center" font-size="11px" color="#BDBDBD">
          © {{ currentYear }} EaseInv. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
