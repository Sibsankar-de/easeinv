enum PaymentBehaviour {
  NEUTRAL
  ADVANCE
  OVERDUE
}

enum CustomerMark {
  REGULAR
  BLACKLISTED
  INACTIVE
}

model Customer {
  id               String           @id @default(uuid()) @db.Uuid
  storeId          String           @db.Uuid
  name             String
  phoneNumber      String?          @default("")
  email            String?          @default("")
  address          String?          @default("")
  totalDue         Float            @default(0)
  advance          Float            @default(0)
  paymentBehaviour PaymentBehaviour @default(NEUTRAL)
  mark             CustomerMark     @default(REGULAR)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  customerDailyStats CustomerDailyStat[]

  @@index([storeId])
  @@index([storeId, name])
  @@index([storeId, phoneNumber])
  @@map("customers")
}
