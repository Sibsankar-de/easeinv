<mjml>
  <mj-head>
    <mj-title>Reset your password - EaseInv</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.05),
          0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }
      .link-text {
        color: #4f39f6;
        text-decoration: none;
        word-break: break-all;
      }
      .footer-link {
        color: #9ca3af;
        text-decoration: none;
        font-weight: 500;
      }
      .footer-link:hover {
        color: #4f39f6;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <!-- LOGO HEADER -->
    <mj-section padding="32px 24px 24px">
      <mj-column>
        <mj-image
          src="https://easeinv.app/easeinv-logo-full.png"
          alt="EaseInv Logo"
          width="120px"
          align="center"
        />
      </mj-column>
    </mj-section>

    <!-- MAIN CARD -->
    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="700"
          color="#111827"
          padding-bottom="16px"
        >
          Reset your password
        </mj-text>

        <mj-text padding-bottom="12px">
          Hi <strong>{{ recipientName }}</strong
          >,
        </mj-text>

        <mj-text padding-bottom="24px">
          We received a request to reset the password for your EaseInv account.
          Please click the button below to choose a new password:
        </mj-text>

        <!-- CTA Button -->
        <mj-button
          background-color="#4f39f6"
          color="#ffffff"
          href="{{resetLink}}"
          font-size="15px"
          font-weight="600"
          border-radius="8px"
          padding="0"
          inner-padding="14px 28px"
          align="center"
        >
          Reset Password
        </mj-button>

        <mj-spacer height="28px" />

        <mj-text
          font-size="13px"
          color="#6B7280"
          padding-bottom="24px"
          align="center"
        >
          This password reset link is only valid for <strong>1 hour</strong>. If
          the link expires, you will need to request a new password reset.
        </mj-text>

        <mj-divider
          border-color="#F3F4F6"
          border-width="1px"
          padding="0 0 20px"
        />

        <!-- Fallback Link -->
        <mj-text font-size="12px" color="#6B7280" padding-bottom="8px">
          If the button above doesn't work, copy and paste this URL into your
          browser:
        </mj-text>
        <mj-text font-size="12px" padding-bottom="20px">
          <a href="{{resetLink}}" class="link-text">{{ resetLink }}</a>
        </mj-text>

        <mj-spacer height="12px" />

        <mj-text font-size="13px" color="#9CA3AF">
          If you did not request a password reset, you can safely ignore this
          email. Your password will not change unless you click the link and
          create a new one.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text
          align="center"
          font-size="12px"
          color="#9CA3AF"
          padding-bottom="12px"
        >
          <a href="https://easeinv.app/about" class="footer-link">About</a>
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/contact" class="footer-link"
            >Contact Support</a
          >
          &nbsp;&bull;&nbsp;
          <a href="https://easeinv.app/privacy-policy" class="footer-link"
            >Privacy Policy</a
          >
        </mj-text>
        <mj-text align="center" font-size="11px" color="#BDBDBD">
          © {{ currentYear }} EaseInv. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
